{{#each results}}
  <div class="character-card">
    <img src="{{image}}" alt="{{name}}" />
    <div class="character-info">
      <div class="name">{{name}}</div>
      <div class="status">Status: {{status}}</div>
      <div class="species">Species: {{species}}</div>
      <div class="gender">Gender: {{gender}}</div>
    </div>
  </div>
{{/each}}